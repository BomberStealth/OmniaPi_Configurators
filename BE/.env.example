PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=configuratori_db
DB_USER=omniapi
DB_PASSWORD=OmniaPi2026!

# IMPORTANTE: cambiare con una stringa lunga e casuale (protegge i login).
# Se lo cambi, tutti i token esistenti decadono e bisogna rifare il login.
JWT_SECRET=configuratori_jwt_secret_change_me
JWT_EXPIRES_IN=7d

# Cartella dove salvare le foto delle bolle (file, non base64 nel DB).
# Punta all'SSD collegato al Raspberry, es: /mnt/ssd/maioli-foto
# Se non impostata, usa ./uploads/maioli nella cartella del BE.
MAIOLI_UPLOAD_DIR=/mnt/ssd/maioli-foto
